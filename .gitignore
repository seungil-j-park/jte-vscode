# Dependencies and reproducible build output.
node_modules/
/dist/
/server/classes/
/server/jte-java.jar
*.class
*.vsix
*.tsbuildinfo

# Local editor profiles, logs, and reports may contain private paths or source text.
/.test-runtime/
/artifacts/
*.log
coverage/

# Build output and IDE metadata created when importing fixtures.
test/fixtures/**/build/
test/fixtures/**/target/
test/fixtures/**/bin/
test/fixtures/**/.gradle/
test/fixtures/**/.settings/
test/fixtures/**/.project
test/fixtures/**/.classpath

# Keep portable development tasks; exclude personal editor and agent settings.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.code-workspace
/.codex/
/AGENTS.md

# Local configuration and credentials.
.env
.env.*
!.env.example
.npmrc
*.local.*
*.pem
*.key
*.p12
*.pfx

# Operating system files.
.DS_Store
Thumbs.db
Desktop.ini
